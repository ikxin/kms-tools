{
  "name": "kms-tools",
  "version": "2.2.0",
  "repository": "ikxin/kms-tools",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "pnpm -C node-vlmcs build && nuxt build",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state --config wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "dev": "pnpm run db:migrate:local && nuxt dev",
    "deploy": "wrangler deploy",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "postinstall": "pnpm -C node-vlmcs build && nuxt prepare",
    "release:preview": "changelogen --no-output",
    "release": "changelogen --clean --release --push"
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.58.0",
    "@cloudflare/workers-types": "^5.20261031.1",
    "@iconify-json/flag": "^1.2.12",
    "@iconify-json/lucide": "^1.2.124",
    "@nuxt/icon": "^2.5.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/seo": "^5.3.12",
    "@tailwindcss/vite": "^4.3.3",
    "@takumi-rs/core": "2.10.0",
    "@takumi-rs/wasm": "2.10.0",
    "changelogen": "^0.6.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.1.0",
    "node-vlmcs": "workspace:*",
    "nuxt": "^4.5.2",
    "nuxt-echarts": "^1.0.1",
    "oxfmt": "^0.64.0",
    "tailwindcss": "^4.3.3",
    "unplugin-vue-components": "32.1.0",
    "vue": "^3.5.41",
    "wrangler": "^4.124.0"
  }
}
